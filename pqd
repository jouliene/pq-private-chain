#!/bin/sh
set -eu
if [ "${1:-}" = assets ]; then
    shift
    exec python3 -IB "$(dirname "$0")/experiments/user-assets/entry.py" "$@"
fi
if [ "${1:-}" = token ]; then
    shift
    exec python3 -IB "$(dirname "$0")/experiments/token-devnet/entry.py" "$@"
fi
exec python3 -IB "$(dirname "$0")/devnet/cli.py" "$@"
